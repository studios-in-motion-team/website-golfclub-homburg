# Freeda CMS API Configuration
# Diese Datei sollte als .env im Projektroot gespeichert werden

# Freeda API Basis-URL (Production)
VITE_FREEDA_API_BASEURL=https://api.devel2.freeda.cloud/public

# Unique Company Identifier
VITE_FREEDA_COMPANY_UUID=9d07193c-f47f-43f3-bdfc-017e3f01eb51

# API Key für Authentifizierung (GEHEIM - nicht in Git einchecken!)
VITE_FREEDA_API_KEY=your-api-key-here

# News-Kategorie Filter (optional)
VITE_NEWS_CATEGORY=news

# Domain für Sitemap-Generierung
VITE_SITEMAP_DOMAIN=https://www.golfclub-homburg.de

# Development/Debug Settings
# 1 = Erzwingt Live-API-Calls auch wenn Cache existiert (nur für Entwicklung)
VITE_FREEDA_FORCE_LIVE=0

# HTML Sanitization (optional)
# false = Deaktiviert HTML-Sanitization (NICHT für Production empfohlen!)
VITE_FREEDA_SANITIZE_HTML=true

# Build-spezifische Einstellungen
# Timeout für API-Requests in Millisekunden
FREEDA_API_TIMEOUT=10000

# Maximale Retry-Versuche bei API-Fehlern
FREEDA_API_MAX_RETRIES=3

# Image-Download-Verhalten
# true = Lädt Bilder als Assets für optimale WebP-Konvertierung
FREEDA_DOWNLOAD_IMAGES=true

# Sitemap-Einstellungen
# Basis-URL für absolute URLs in Sitemap
SITEMAP_BASE_URL=https://www.golfclub-homburg.de

# robots.txt Generierung
GENERATE_ROBOTS_TXT=true

# Cache-Verhalten
# Pfad für News-Cache-Datei (relativ zum Projektroot)
FREEDA_CACHE_PATH=content/freeda-news.json

# Asset-Verhalten
# Präfix für heruntergeladene Bilder in src/assets/
FREEDA_ASSET_PREFIX=freedaimg_

# Logging-Level für Prebuild-Script
# Optionen: error, warn, info, debug
LOG_LEVEL=info