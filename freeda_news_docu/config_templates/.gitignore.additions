# Freeda CMS Generated Files
# Diese Dateien werden vom Prebuild-Prozess generiert

# News-Cache-Datei (wird bei jedem Build neu erstellt)
content/freeda-news.json

# Sitemap und SEO-Dateien (werden automatisch generiert)
public/sitemap.xml
public/robots.txt

# Heruntergeladene und optimierte Bilder
public/uploads/freeda/
src/assets/freedaimg_*

# Environment Variables mit sensiblen Daten
.env
.env.local
.env.production

# Build-Ausgabe
dist/

# Dependencies
node_modules/

# IDE-Dateien
.vscode/settings.json
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporäre Dateien
.tmp/
.cache/

# MacOS
.DS_Store

# Windows
Thumbs.db

# Editor Backup-Dateien  
*~
*.swp
*.swo

# Astro-spezifische Dateien
.astro/