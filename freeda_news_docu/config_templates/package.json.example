{
  "name": "astro-golfclub-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run prebuild && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prebuild": "node scripts/prebuild.js",
    "prebuild:smoke": "node scripts/prebuild-smoke.js",
    "test:build": "npm run prebuild:smoke && npm run build",
    "clean": "rm -rf dist/ content/freeda-news.json public/sitemap.xml public/robots.txt src/assets/freedaimg_*"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.0",
    "astro": "^4.0.0",
    "tailwindcss": "^3.0.0",
    
    "image-size": "^1.0.2",
    "marked": "^12.0.0",
    "sanitize-html": "^2.12.1",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.9.5",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.12.0"
  }
}