---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import SubNavigation from '../../components/SubNavigation.astro';

const clubNavItems = [
  { label: 'Über uns', href: '/club' },
  { label: 'Die Menschen', href: '/club/menschen' },
  { label: 'Gastronomie', href: '/gastronomie' },
  { label: 'Mitgliedschaft/Tarife', href: '/mitgliedschaft' },
  { label: 'Partner', href: '/club/partner' },
  { label: 'Newsletter', href: '/club/newsletter' },
];
---

<BaseLayout title="Über Uns - Golfclub Homburg Websweiler Hof">
  <Header slot="header" />
  
  <div class="pt-14">
    <PageHero
      title="Über Uns"
      subtitle="Erholen, Golfspielen und Wohlfühlen am Websweiler Hof"
      backgroundImage="/images/header02.webp"
    />

    <SubNavigation
      items={clubNavItems}
      activeLabel="Über uns"
      parentTitle="DER CLUB"
    />

    <div class="container mx-auto px-4 py-20 max-w-6xl">
      <!-- Philosophy Section -->
      <div class="grid lg:grid-cols-2 gap-16 items-center mb-24">
        <div class="relative">
          <div class="aspect-[4/3] bg-gray-200 rounded-lg overflow-hidden shadow-2xl relative z-10">
            <img
              src="/images/clubhaus.jpg"
              alt="Clubhaus Websweiler Hof"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="absolute -top-10 -left-10 w-40 h-40 bg-golf-gold opacity-10 rounded-full -z-0"></div>
          <div class="absolute -bottom-10 -right-10 w-64 h-64 bg-golf-green opacity-5 rounded-full -z-0"></div>
        </div>
        <div>
          <h2 class="font-serif text-4xl md:text-5xl font-bold text-golf-green mb-8 leading-tight">Es geht um mehr als nur den Sport</h2>
          <div class="prose prose-lg text-gray-700 space-y-6">
            <p class="p-6 bg-golf-light border-l-4 border-golf-gold italic text-xl">
              "Einige Menschen glauben, das Wichtigste beim Golf sei es, einen kleinen Ball mit möglichst wenig Schlägen in ein Loch zu befördern. Uns ist diese Sicht etwas zu einseitig..."
            </p>
            <p>
              Wir finden, es geht beim Golf um etwas viel Wesentlicheres: nämlich ums <strong>Wohlfühlen</strong>.
              Und das fängt an mit dem geeigneten Platz und endet im Clubhaus, wo Sie Ihre Golfrunde in Ruhe ausklingen lassen können und Menschen treffen, die Ihre Begeisterung für diesen Sport teilen.
            </p>
          </div>
        </div>
      </div>

      <div class="mb-24 text-center max-w-4xl mx-auto">
        <p class="font-serif text-2xl md:text-3xl text-golf-green leading-relaxed">
          Die exklusive, traditionsreiche Gemeinschaft am Websweiler Hof verbindet Leidenschaft für den Sport mit einem hohen Anspruch an Service und Qualität.
        </p>
      </div>

      <!-- Contact & Hours Grid -->
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white p-12 shadow-xl rounded-lg border-t-4 border-golf-gold">
          <div class="flex items-center space-x-4 mb-8">
            <div class="w-12 h-12 bg-golf-light rounded-full flex items-center justify-center text-golf-gold">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <h3 class="font-serif text-2xl font-bold text-golf-green">Kontakt</h3>
          </div>
          <div class="space-y-4 text-gray-700">
            <p class="text-lg font-bold">Websweiler Hof</p>
            <p>D-66424 Homburg/Saar</p>
            <div class="pt-4 space-y-2">
              <p class="flex justify-between border-b border-gray-100 pb-2">
                <span class="text-gray-400 uppercase text-xs font-bold tracking-widest">Telefon</span>
                <span class="font-semibold">06841 77 776-0</span>
              </p>
              <p class="flex justify-between border-b border-gray-100 pb-2">
                <span class="text-gray-400 uppercase text-xs font-bold tracking-widest">Fax</span>
                <span class="font-semibold">06841 77 776-66</span>
              </p>
              <p class="flex justify-between">
                <span class="text-gray-400 uppercase text-xs font-bold tracking-widest">E-Mail</span>
                <span class="font-semibold text-golf-gold">info@golfsaar.de</span>
              </p>
            </div>
          </div>
        </div>

        <div class="bg-white p-12 shadow-xl rounded-lg border-t-4 border-golf-green text-center flex flex-col justify-center">
          <div class="w-16 h-16 bg-golf-light rounded-full flex items-center justify-center text-golf-green mx-auto mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-serif text-2xl font-bold text-golf-green mb-6">Sekretariat & Büro</h3>
          <p class="text-lg text-gray-700 mb-6">
            Anmeldung gerne nach Vereinbarung per E-Mail oder Telefon.
          </p>
          <div class="bg-golf-light p-4 rounded-md">
            <p class="text-sm text-golf-green font-bold italic">
              Tipp: Greenfee-Zahlung jederzeit am Automaten per EC-Karte möglich!
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>
