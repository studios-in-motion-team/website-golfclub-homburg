---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";

const highlights = [
    {
        title: "Erste Abschläge",
        description:
            "Trainieren Sie unter Anleitung unserer Golf-Professionals Ihre ersten Schläge auf der Driving Range – Erfolgserlebnis garantiert.",
        icon: "golf-ball",
    },
    {
        title: "Kennenlernen und Austauschen",
        description:
            "In kleinen Gruppen mit Gleichgesinnten lernen – für maximalen Spaß und soziale Kontakte.",
        icon: "heart",
    },
    {
        title: "Golf erleben",
        description:
            "Lernen Sie die Golf- und Freizeitanlage (Websweiler Hof) in entspannter Atmosphäre kennen.",
        icon: "flag",
    },
];

const features = [
    {
        title: "Leihschläger inklusive",
        description:
            "Alles, was Sie für Ihren ersten Start brauchen, stellen wir Ihnen kostenlos zur Verfügung.",
    },
    {
        title: "Driving Range",
        description:
            "Übungsbälle und die Nutzung der Driving Range sind während des Kurses komplett enthalten.",
    },
    {
        title: "Open End",
        description:
            "Nach dem Kurs können Sie Chipping, Putting und unseren Kurzplatz weiter kostenfrei ausprobieren.",
    },
];
