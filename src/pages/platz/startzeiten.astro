---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import SubNavigation from '../../components/SubNavigation.astro';

const platzNavItems = [
  { label: 'E-Scoring', href: '/platz/e-scoring' },
  { label: 'Startzeiten buchen', href: '/platz/startzeiten' },
  { label: 'Platzübersicht', href: '/platz' },
  { label: 'Persönliche Scorekarte', href: '/platz/scorekarte' },
  { label: 'Spielbahnen', href: '/platz/spielbahnen' },
  { label: 'Übungsbereich', href: '/platz/uebungsbereich' },
];
---

<BaseLayout title="Startzeiten buchen - Golfclub Homburg Websweiler Hof">
  <Header slot="header" />
  
  <div class="pt-14">
    <PageHero
      title="Startzeiten buchen"
      subtitle="Reservieren Sie Ihre Spielzeit am Websweiler Hof"
      backgroundImage="/images/header02.webp"
    />

    <SubNavigation
      items={platzNavItems}
      activeLabel="Startzeiten buchen"
      parentTitle="GOLFPLATZ"
    />

    <div class="container mx-auto px-4 py-16 max-w-4xl text-center">
      <h2 class="font-serif text-3xl font-bold text-golf-green mb-6">Startzeitenreservierung</h2>
      <p class="text-lg text-gray-700 mb-8">
        Buchen Sie Ihre Startzeit bequem online über unsere PC CADDIE App oder kontaktieren Sie unser Sekretariat.
      </p>
      
      <div class="bg-white p-8 shadow-xl rounded-lg border-t-4 border-golf-gold mb-8">
        <h3 class="font-bold text-xl text-golf-green mb-4">Online-Buchung</h3>
        <p class="text-gray-600 mb-6">
          Über die PC CADDIE App können Sie als Mitglied bequem Ihre Startzeiten buchen.
        </p>
        <a
          href="#"
          class="inline-block bg-golf-green text-white px-8 py-3 font-bold uppercase tracking-wider hover:bg-opacity-90 transition-colors"
        >
          Zur Buchung
        </a>
      </div>

      <div class="bg-golf-light p-6 rounded-lg">
        <p class="text-gray-700">
          <strong>Telefonische Reservierung:</strong><br />
          06841 77 776-0
        </p>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>
