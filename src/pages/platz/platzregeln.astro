---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import SubNavigation from '../../components/SubNavigation.astro';

const platzNavItems = [
  { label: 'E-Scoring', href: '/platz/e-scoring' },
  { label: 'Startzeiten buchen', href: '/platz/startzeiten' },
  { label: 'Platzübersicht', href: '/platz' },
  { label: 'Persönliche Scorekarte', href: '/platz/scorekarte' },
  { label: 'Spielbahnen', href: '/platz/spielbahnen' },
  { label: 'Übungsbereich', href: '/platz/uebungsbereich' },
];
---

<BaseLayout title="Platzregeln - Golfclub Homburg Websweiler Hof">
  <Header slot="header" />
  
  <div class="pt-14">
    <PageHero
      title="Platzregeln"
      subtitle="Die wichtigsten Regeln für Ihr Spiel"
      backgroundImage="/images/header02.webp"
    />

    <SubNavigation
      items={platzNavItems}
      activeLabel="Platzübersicht"
      parentTitle="GOLFPLATZ"
    />

    <div class="container mx-auto px-4 py-16 max-w-4xl">
      <div class="bg-white p-8 shadow-xl rounded-lg">
        <h2 class="font-serif text-3xl font-bold text-golf-green mb-8">Platzregeln Websweiler Hof</h2>
        <p class="text-gray-700 mb-6">
          Bitte beachten Sie die geltenden Platzregeln während Ihres Spiels.
          Detaillierte Informationen erhalten Sie im Sekretariat oder an den Aushängen.
        </p>
        <a
          href="/kontakt"
          class="inline-block bg-golf-green text-white px-8 py-3 font-bold uppercase tracking-wider hover:bg-opacity-90 transition-colors"
        >
          Kontakt aufnehmen
        </a>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>
