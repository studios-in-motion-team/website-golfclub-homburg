---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import SubNavigation from '../../components/SubNavigation.astro';
import GallerySlider from '../../components/GallerySlider.astro';

const platzNavItems = [
  { label: 'E-Scoring', href: '/platz/e-scoring' },
  { label: 'Startzeiten buchen', href: '/platz/startzeiten' },
  { label: 'Platzübersicht', href: '/platz' },
  { label: 'Persönliche Scorekarte', href: '/platz/scorekarte' },
  { label: 'Spielbahnen', href: '/platz/spielbahnen' },
  { label: 'Übungsbereich', href: '/platz/uebungsbereich' },
];
---

<BaseLayout title="Der Golfplatz - Golfclub Homburg Websweiler Hof">
  <Header slot="header" />
  
  <div class="pt-14">
    <PageHero
      title="Der Golfplatz"
      subtitle="Hügeliges Gelände, sportliche Herausforderungen und weite Ausblicke"
      backgroundImage="/images/header02.webp"
    />

    <SubNavigation
      items={platzNavItems}
      activeLabel="Platzübersicht"
      parentTitle="GOLFPLATZ"
    />

    <div class="container mx-auto px-4 py-16 max-w-6xl">
      <div class="grid lg:grid-cols-2 gap-12 items-stretch mb-16">
        <div
          id="platz-image"
          class="shadow-xl rounded-lg overflow-hidden border-4 border-white relative min-h-[400px] cursor-pointer group"
        >
          <img
            src="/images/platzuebersicht.jpg"
            alt="Platzübersicht Golfclub Homburg"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-20 transition-all duration-300 flex items-center justify-center">
            <span class="text-white opacity-0 group-hover:opacity-100 font-bold bg-black bg-opacity-50 px-4 py-2 rounded transform translate-y-4 group-hover:translate-y-0 transition-all duration-300">
              Vergrößern
            </span>
          </div>
        </div>

        <div class="flex flex-col justify-center">
          <h1 class="font-serif text-3xl md:text-4xl font-bold text-golf-green mb-6">Platzübersicht Golfclub Homburg</h1>
          <div class="prose prose-lg text-gray-700 mb-8">
            <p class="mb-6">
              Die ersten neun Löcher liegen reizvoll unterhalb der Ortschaft Websweiler in teilweise hügeligem Gelände und fordern dem Spieler taktisches und präzises Spiel ab.
            </p>
            <p class="mb-6">
              Der zweite Teil des Platzes führt entlang des Felsbaches hinauf zum hochgelegenem Teil der Anlage. Hier ist der Wind ein steter Begleiter des Golfers und zwingt ihm eine andere Spielweise auf.
            </p>
            <p>
              Der Blick über Homburg und Umgebung entschädigt den Spieler für seine Geduld und Leistung bevor er die sportlich anspruchsvollen Schlußlöcher auf dem Weg zum "19. Loch" antritt.
            </p>
          </div>
          <a
            href="/platz/spielbahnen"
            class="inline-block bg-golf-green text-white font-bold py-3 px-8 rounded hover:bg-opacity-90 transition-colors duration-200 uppercase tracking-widest text-sm shadow-md self-start"
          >
            Zu den Spielbahnen
          </a>
        </div>
      </div>
    </div>

    <!-- Lightbox -->
    <div id="lightbox" class="hidden fixed inset-0 z-50 bg-black bg-opacity-90 flex items-center justify-center p-4 cursor-pointer">
      <div class="relative max-w-7xl max-h-screen">
        <img
          src="/images/platzuebersicht.jpg"
          alt="Platzübersicht Golfclub Homburg - Großansicht"
          class="max-w-full max-h-[90vh] object-contain rounded-lg shadow-2xl"
        />
        <button
          id="lightbox-close"
          class="absolute top-4 right-4 text-white hover:text-golf-gold focus:outline-none"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <GallerySlider />

    <div class="bg-gray-50 py-16 mt-16">
      <div class="container mx-auto px-4 text-center">
        <h2 class="font-serif text-3xl font-bold text-golf-green mb-8">Übersicht</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-left max-w-5xl mx-auto">
          <div class="bg-white p-6 shadow-sm border-t-4 border-golf-gold">
            <h3 class="font-bold text-lg mb-2">18-Loch Meisterschaftsplatz</h3>
            <p class="text-sm text-gray-600">Par 72, anspruchsvoll und landschaftlich reizvoll.</p>
          </div>
          <div class="bg-white p-6 shadow-sm border-t-4 border-golf-green">
            <h3 class="font-bold text-lg mb-2">Kurzplatz</h3>
            <p class="text-sm text-gray-600">Ideal für Einsteiger und zum Üben des kurzen Spiels.</p>
          </div>
          <div class="bg-white p-6 shadow-sm border-t-4 border-gray-800">
            <h3 class="font-bold text-lg mb-2">Driving Range</h3>
            <p class="text-sm text-gray-600">Großzügige Übungsanlagen mit überdachten Abschlagplätzen.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<script>
  const platzImage = document.getElementById('platz-image');
  const lightbox = document.getElementById('lightbox');
  const lightboxClose = document.getElementById('lightbox-close');

  platzImage?.addEventListener('click', () => {
    lightbox?.classList.remove('hidden');
  });

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) {
      lightbox.classList.add('hidden');
    }
  });

  lightboxClose?.addEventListener('click', () => {
    lightbox?.classList.add('hidden');
  });
</script>
