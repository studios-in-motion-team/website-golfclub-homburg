import ContentSection from '../components/ContentSection.astro';
import NewsSection from '../components/NewsSection.astro';
import GallerySlider from '../components/GallerySlider.astro';
---

<BaseLayout title="Golfclub Homburg Websweiler Hof">
  <Header slot="header" />
  <Hero />
  <ServiceDesk />
  <ContentSection />
