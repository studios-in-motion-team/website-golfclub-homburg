---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import SubNavigation from '../../components/SubNavigation.astro';

const sportNavItems = [
  { label: 'Abteilungen', href: '/sport' },
  { label: 'Mannschaften', href: '/sport/mannschaften' },
  { label: 'Jugend', href: '/sport/jugend' },
  { label: 'Turniere', href: '/sport/turniere' },
];
---

<BaseLayout title="Abteilungen - Golfclub Homburg Websweiler Hof">
  <Header slot="header" />
  
  <div class="pt-14">
    <PageHero
      title="Abteilungen"
      subtitle="Unsere Spielgruppen und regelmäßigen Treffpunkte"
      backgroundImage="/images/header02.webp"
    />

    <SubNavigation
      items={sportNavItems}
      activeLabel="Abteilungen"
      parentTitle="SPORT"
    />

    <div class="container mx-auto px-4 py-12 max-w-6xl">
      <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
        <h2 class="font-serif text-3xl font-bold text-golf-green mb-6">Unsere Abteilungen</h2>
        
        <div class="prose prose-lg max-w-none text-gray-700 mb-8">
          <p>
            Der Golfclub Homburg Websweiler Hof bietet seinen Mitgliedern ein vielfältiges 
            sportliches Programm. Von regelmäßigen Spieltagen für verschiedene Zielgruppen 
            bis hin zu geselligen Runden – hier findet jeder sein passendes Format.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <a href="/sport/abteilungen/ladies-day" class="group bg-gradient-to-br from-pink-50 to-white p-6 rounded-lg shadow-md border-l-4 border-pink-400 hover:shadow-xl transition-all">
            <h3 class="font-bold text-xl text-golf-green mb-2 group-hover:text-pink-600 transition-colors">Ladies Day</h3>
            <p class="text-gray-600 text-sm">Jeden Donnerstag – Golf unter Frauen in entspannter Atmosphäre.</p>
          </a>

          <a href="/sport/abteilungen/mens-day" class="group bg-gradient-to-br from-blue-50 to-white p-6 rounded-lg shadow-md border-l-4 border-blue-400 hover:shadow-xl transition-all">
            <h3 class="font-bold text-xl text-golf-green mb-2 group-hover:text-blue-600 transition-colors">Mens Day</h3>
            <p class="text-gray-600 text-sm">Jeden Mittwoch – Der Herrentag am Websweiler Hof.</p>
          </a>

          <a href="/sport/abteilungen/seniorentag" class="group bg-gradient-to-br from-amber-50 to-white p-6 rounded-lg shadow-md border-l-4 border-amber-400 hover:shadow-xl transition-all">
            <h3 class="font-bold text-xl text-golf-green mb-2 group-hover:text-amber-600 transition-colors">Seniorentag</h3>
            <p class="text-gray-600 text-sm">Jeden Dienstag – Golf mit Erfahrung und Genuss.</p>
          </a>
        </div>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>
