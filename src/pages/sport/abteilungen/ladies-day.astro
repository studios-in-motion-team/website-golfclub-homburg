---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHero from '../../../components/PageHero.astro';
import SubNavigation from '../../../components/SubNavigation.astro';
import SidebarLayout from '../../../components/SidebarLayout.astro';

const sportNavItems = [
  { label: 'Abteilungen', href: '/sport' },
  { label: 'Mannschaften', href: '/sport/mannschaften' },
  { label: 'Jugend', href: '/sport/jugend' },
  { label: 'Turniere', href: '/sport/turniere' },
];

const sidebarItems = [
  { label: 'Abteilungen Übersicht', href: '/sport' },
  { label: 'Ladies Day', href: '/sport/abteilungen/ladies-day' },
  { label: 'Mens Day', href: '/sport/abteilungen/mens-day' },
  { label: 'Seniorentag', href: '/sport/abteilungen/seniorentag' },
];
---

<BaseLayout title="Ladies Day - Golfclub Homburg Websweiler Hof">
  <Header slot="header" />
  
  <div class="pt-14">
    <PageHero
      title="Ladies Day"
      subtitle="„Immer wieder dienstags...“"
      backgroundImage="/images/header02.webp"
    />

    <SubNavigation
      items={sportNavItems}
      activeLabel="Abteilungen"
      parentTitle="SPORT"
    />

    <SidebarLayout sidebarTitle="ABTEILUNGEN" sidebarItems={sidebarItems} currentPath="/sport/abteilungen/ladies-day">
      <div class="prose prose-lg max-w-none text-gray-700">
        <h2 class="font-serif text-3xl font-bold text-golf-green mb-6">Ladies Day 2025</h2>
        
        <div class="rounded-lg overflow-hidden shadow-lg mb-8">
          <img 
            src="/images/abteilungen/ladies-2025.jpg" 
            alt="Ladies Day Gruppe 2025" 
            class="w-full h-auto object-cover"
          />
        </div>

        <p class="mb-6">
          Liebe Golferin, „immer wieder dienstags …“ ist unser Platz am Nachmittag für unseren 
          <strong>"Ladies Day"</strong> reserviert. Wir sind Frauen aller Alters- und Handicap-Klassen, 
          die sich von April bis Oktober zu 9- oder 18-Loch Turnieren treffen.
        </p>

        <p class="mb-6">
          Die gemeinsamen Golfrunden mit Abschlagszeiten ab 14:00 Uhr aufwärts bieten sowohl 
          Handicap-relevante Turniere als auch interessante Spielformen zum Spaß. Im Anschluss 
          findet ein gemütliches Beisammensein in unserer Clubgastronomie mit einer Preisverleihung statt.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
          <div class="bg-golf-gold/10 border-l-4 border-golf-gold p-6 rounded-r-lg">
            <h3 class="font-bold text-lg text-golf-green mb-2">Termine & Anmeldung</h3>
            <p class="text-sm text-gray-600 mb-0">
              Anmeldung über PCC bis 15:00 Uhr am Sonntag vor dem jeweiligen Spieltag.
            </p>
          </div>
          <div class="bg-golf-green/5 border-l-4 border-golf-green p-6 rounded-r-lg">
            <h3 class="font-bold text-lg text-golf-green mb-2">Kosten</h3>
            <p class="text-sm text-gray-600 mb-0">
              Erste Teilnahme zum Ausprobieren kostenfrei. Danach 10 € pro Spieltag oder 100 € Jahresbeitrag.
            </p>
          </div>
        </div>

        <h3 class="font-serif text-xl font-bold text-golf-green mt-8 mb-4">Ihre Ansprechpartnerin</h3>
        <div class="bg-white border border-gray-200 rounded-lg p-6 flex flex-col md:flex-row items-center gap-6 shadow-sm mb-8">
          <div class="flex-1">
            <h4 class="font-bold text-lg text-golf-green">Martina-Maria Seidel</h4>
            <p class="text-gray-600 mb-2">Ladies-Captain</p>
            <div class="space-y-1">
              <a href="tel:+491759633564" class="flex items-center text-golf-green hover:underline">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                0175 963 3564
              </a>
              <a href="mailto:m.m.seidel@web.de" class="flex items-center text-golf-green hover:underline">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                m.m.seidel@web.de
              </a>
            </div>
            <p class="text-xs text-gray-400 mt-4 italic">Zusammen mit Renate, Carmen, Anne und Claudia.</p>
          </div>
        </div>

        <h3 class="font-serif text-xl font-bold text-golf-green mt-8 mb-4">Downloads & Links</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a 
            href="/documents/LD_Spieltermine_2025.pdf" 
            target="_blank"
            class="flex items-center p-4 bg-gray-50 rounded-lg border border-gray-200 hover:bg-golf-gold/5 hover:border-golf-gold transition-colors group"
          >
            <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center mr-4 group-hover:bg-red-200 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <span class="block font-bold text-gray-900">Ladies Day Kalender 2025</span>
              <span class="text-xs text-gray-500 uppercase">PDF Download</span>
            </div>
          </a>

          <a 
            href="https://www.facebook.com/GCHomburg" 
            target="_blank"
            class="flex items-center p-4 bg-gray-50 rounded-lg border border-gray-200 hover:bg-blue-50 hover:border-blue-300 transition-colors group"
          >
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center mr-4 group-hover:bg-blue-200 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </div>
            <div>
              <span class="block font-bold text-gray-900">GC Homburg Facebook</span>
              <span class="text-xs text-gray-500 uppercase">Social Media</span>
            </div>
          </a>
        </div>
      </div>
    </SidebarLayout>
  </div>

  <Footer slot="footer" />
</BaseLayout>
