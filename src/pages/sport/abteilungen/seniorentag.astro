---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import PageHero from "../../../components/PageHero.astro";
import SubNavigation from "../../../components/SubNavigation.astro";
import SidebarLayout from "../../../components/SidebarLayout.astro";

const sportNavItems = [
  { label: "Abteilungen", href: "/sport" },
  { label: "Mannschaften", href: "/sport/mannschaften" },
  { label: "Jugend", href: "/sport/jugend" },
  { label: "Turniere", href: "/sport/turniere" },
];

const sidebarItems = [
  { label: "Abteilungen Übersicht", href: "/sport" },
  { label: "Ladies Day", href: "/sport/abteilungen/ladies-day" },
  { label: "Mens Day", href: "/sport/abteilungen/mens-day" },
  { label: "Seniorentag", href: "/sport/abteilungen/seniorentag" },
];
---

<BaseLayout title="Seniorentag - Golfclub Homburg Websweiler Hof">
  <Header slot="header" />

  <div class="pt-14">
    <PageHero
      title="Seniorentag"
      subtitle="Golf mit Erfahrung und Genuss"
      backgroundImage="/images/header02.webp"
    />

    <SubNavigation
      items={sportNavItems}
      activeLabel="Abteilungen"
      parentTitle="SPORT"
    />

    <SidebarLayout
      sidebarTitle="ABTEILUNGEN"
      sidebarItems={sidebarItems}
      currentPath="/sport/abteilungen/seniorentag"
    >
      <div class="prose prose-lg max-w-none text-gray-700">
        <h2
          class="font-serif text-3xl font-bold text-golf-green mb-6"
        >
          Seniorentag
        </h2>

        <p class="mb-6">
          Der Seniorentag richtet sich an alle Mitglieder ab 60 Jahren
          und bietet eine hervorragende Gelegenheit, in angenehmer
          Gesellschaft eine Runde Golf zu genießen.
        </p>

        <div
          class="bg-golf-gold/10 border-l-4 border-golf-gold p-6 rounded-r-lg mb-8"
        >
          <h3 class="font-bold text-lg text-golf-green mb-2">
            Jeden Dienstag
          </h3>
          <p class="text-gray-600 mb-0">
            Treffpunkt um 10:00 Uhr am Clubhaus. Anmeldung bis Montag
            18:00 Uhr im Sekretariat.
          </p>
        </div>

        <h3
          class="font-serif text-xl font-bold text-golf-green mt-8 mb-4"
        >
          Das erwartet Sie
        </h3>
        <ul class="space-y-2 mb-6 list-none pl-0">
          <li class="flex items-start">
            <span class="text-golf-gold mr-3">●</span>
            <span
              >Entspannte 9- oder 18-Loch-Runden in netter
              Gesellschaft</span
            >
          </li>
          <li class="flex items-start">
            <span class="text-golf-gold mr-3">●</span>
            <span>Angepasstes Spieltempo und familäre Atmosphäre</span
            >
          </li>
          <li class="flex items-start">
            <span class="text-golf-gold mr-3">●</span>
            <span>Gemeinsames Mittagessen nach der Runde</span>
          </li>
          <li class="flex items-start">
            <span class="text-golf-gold mr-3">●</span>
            <span>Regelmäßige Ausflüge zu benachbarten Golfclubs</span
            >
          </li>
        </ul>

        <h3
          class="font-serif text-xl font-bold text-golf-green mt-8 mb-4"
        >
          Kontakt & Anmeldung
        </h3>
        <p class="mb-6">
          Bei Fragen zum Seniorentag wenden Sie sich bitte an unser
          Sekretariat oder direkt an den Seniorenkapitän.
        </p>

        <a
          href="/kontakt"
          class="inline-block bg-golf-green text-white font-bold py-3 px-8 rounded hover:bg-opacity-90 transition-colors duration-200 uppercase tracking-widest text-sm shadow-md no-underline"
        >
          Jetzt anmelden
        </a>
      </div>
    </SidebarLayout>
  </div>

  <Footer slot="footer" />
</BaseLayout>
