---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHero from '../../../components/PageHero.astro';
import SubNavigation from '../../../components/SubNavigation.astro';
import SidebarLayout from '../../../components/SidebarLayout.astro';

const sportNavItems = [
  { label: 'Abteilungen', href: '/sport' },
  { label: 'Mannschaften', href: '/sport/mannschaften' },
  { label: 'Jugend', href: '/sport/jugend' },
  { label: 'Turniere', href: '/sport/turniere' },
];

const sidebarItems = [
  { label: 'Übersicht', href: '/sport/turniere' },
  { label: 'Turnieranmeldung', href: '/sport/turniere/turnieranmeldung' },
  { label: 'Startlisten', href: '/sport/turniere/startlisten' },
  { label: 'Ergebnisse', href: '/sport/turniere/ergebnisse' },
];
---

<BaseLayout title="Ergebnisse - Golfclub Homburg Websweiler Hof">
  <Header slot="header" />
  
  <div class="pt-14">
    <PageHero
      title="Ergebnisse"
      backgroundImage="/images/header02.webp"
    />

    <SubNavigation
      items={sportNavItems}
      activeLabel="Turniere"
      parentTitle="SPORT"
    />

    <SidebarLayout sidebarTitle="TURNIERE" sidebarItems={sidebarItems} currentPath="/sport/turniere/ergebnisse">
      <h2 class="font-serif text-3xl font-bold text-golf-green mb-6">Turnierergebnisse</h2>
      
      <div class="prose prose-lg max-w-none text-gray-700">
        <p class="mb-6">
          Hier finden Sie die Ergebnisse unserer vergangenen Turniere. Die Ergebnisse werden 
          in der Regel am Tag des Turniers veröffentlicht.
        </p>

        <div class="bg-golf-gold/10 border-l-4 border-golf-gold p-6 rounded-r-lg mb-8">
          <h3 class="font-bold text-lg text-golf-green mb-2">Handicap-Anpassung</h3>
          <p class="text-gray-600 mb-0">
            Bei vorgabewirksamen Turnieren wird Ihr Handicap automatisch durch den DGV 
            auf Grundlage Ihres gespielten Ergebnisses angepasst.
          </p>
        </div>

        <h3 class="font-serif text-xl font-bold text-golf-green mt-8 mb-4">Aktuelle Ergebnisse</h3>
        
        <div class="bg-gray-50 rounded-lg p-8 text-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-golf-green/30 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          <p class="text-gray-500 mb-4">Die aktuellen Turnierergebnisse werden hier angezeigt.</p>
          <p class="text-sm text-gray-400">Ergebnisse der vergangenen Saison folgen in Kürze</p>
        </div>

        <h3 class="font-serif text-xl font-bold text-golf-green mt-8 mb-4">Archiv</h3>
        <p class="mb-6">
          Ergebnisse vergangener Jahre können auf Anfrage im Sekretariat eingesehen werden.
        </p>

        <h3 class="font-serif text-xl font-bold text-golf-green mt-8 mb-4">Clubmeisterschaften</h3>
        <p class="mb-6">
          Die Ergebnisse unserer jährlichen Clubmeisterschaften werden hier und im Clubhaus 
          veröffentlicht.
        </p>
      </div>
    </SidebarLayout>
  </div>

  <Footer slot="footer" />
</BaseLayout>
