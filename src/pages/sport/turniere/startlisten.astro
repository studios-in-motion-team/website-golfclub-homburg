---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHero from '../../../components/PageHero.astro';
import SubNavigation from '../../../components/SubNavigation.astro';
import SidebarLayout from '../../../components/SidebarLayout.astro';

const sportNavItems = [
  { label: 'Abteilungen', href: '/sport' },
  { label: 'Mannschaften', href: '/sport/mannschaften' },
  { label: 'Jugend', href: '/sport/jugend' },
  { label: 'Turniere', href: '/sport/turniere' },
];

const sidebarItems = [
  { label: 'Übersicht', href: '/sport/turniere' },
  { label: 'Turnieranmeldung', href: '/sport/turniere/turnieranmeldung' },
  { label: 'Startlisten', href: '/sport/turniere/startlisten' },
  { label: 'Ergebnisse', href: '/sport/turniere/ergebnisse' },
];
---

<BaseLayout title="Startlisten - Golfclub Homburg Websweiler Hof">
  <Header slot="header" />
  
  <div class="pt-14">
    <PageHero
      title="Startlisten"
      backgroundImage="/images/header02.webp"
    />

    <SubNavigation
      items={sportNavItems}
      activeLabel="Turniere"
      parentTitle="SPORT"
    />

    <SidebarLayout sidebarTitle="TURNIERE" sidebarItems={sidebarItems} currentPath="/sport/turniere/startlisten">
      <h2 class="font-serif text-3xl font-bold text-golf-green mb-6">Startlisten</h2>
      
      <div class="prose prose-lg max-w-none text-gray-700">
        <p class="mb-6">
          Hier finden Sie die Startlisten für anstehende Turniere. Die Startzeiten werden in 
          der Regel 1-2 Tage vor dem Turnier veröffentlicht.
        </p>

        <div class="bg-golf-gold/10 border-l-4 border-golf-gold p-6 rounded-r-lg mb-8">
          <h3 class="font-bold text-lg text-golf-green mb-2">Benachrichtigungen</h3>
          <p class="text-gray-600 mb-0">
            Wenn Sie sich für ein Turnier angemeldet haben, erhalten Sie Ihre Startzeit 
            automatisch per E-Mail.
          </p>
        </div>

        <h3 class="font-serif text-xl font-bold text-golf-green mt-8 mb-4">Aktuelle Startlisten</h3>
        
        <div class="bg-gray-50 rounded-lg p-8 text-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-golf-green/30 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
          <p class="text-gray-500 mb-4">Aktuell sind keine Startlisten verfügbar.</p>
          <p class="text-sm text-gray-400">Die Startlisten werden vor dem jeweiligen Turnier veröffentlicht.</p>
        </div>

        <h3 class="font-serif text-xl font-bold text-golf-green mt-8 mb-4">Informationen zur Startzeit</h3>
        <ul class="list-disc list-inside space-y-2 mb-6">
          <li>Bitte finden Sie sich spätestens 30 Minuten vor Ihrer Startzeit ein</li>
          <li>Die Flights werden nach Handicap zusammengestellt</li>
          <li>Sonderwünsche (z.B. gemeinsames Spielen) können bei der Anmeldung angegeben werden</li>
        </ul>
      </div>
    </SidebarLayout>
  </div>

  <Footer slot="footer" />
</BaseLayout>
