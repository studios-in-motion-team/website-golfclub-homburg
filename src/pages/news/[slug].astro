---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";
import ArticleContent from "../../components/ArticleContent.astro";
import { fetchFreedaNews } from "../../utils/freeda-api-client.js";

export async function getStaticPaths() {
  // Always include local placeholders to ensure routes exist in dev
  const placeholderNews = [
    {
      uuid: 'sample-1',
      name: 'Saisonstart 2026 - Neue Platzregeln',
      created: '2026-01-15',
      slug: 'saisonstart-2026-neue-platzregeln',
      isHighlighted: 1,
      textShort: 'Ab März gelten neue Platzregeln und die Saison 2026 kann beginnen.',
      media: { url: '/images/bahnen/bahn1.jpg', name: 'Golfplatz im Frühling' }
    },
    {
      uuid: 'sample-2',
      name: 'Erfolgreiche Winterarbeiten abgeschlossen',
      created: '2026-01-10',
      slug: 'winterarbeiten-abgeschlossen',
      isHighlighted: 0,
      textShort: 'Die umfangreichen Pflegemaßnahmen während der Wintermonate sind abgeschlossen.',
      media: { url: '/images/bahnen/bahn2.jpg', name: 'Platzpflege' }
    }
  ];

  // Prüfe, ob ein prebuild Cache existiert und verwende diesen bevorzugt
  const cachePath = path.resolve(process.cwd(), 'content/freeda-news.json');
  const forceLive = String(process.env.VITE_FREEDA_FORCE_LIVE || '').toLowerCase();
  const shouldForceLive = forceLive === '1' || forceLive === 'true' || forceLive === 'yes';
  try {
    if (!shouldForceLive && fs.existsSync(cachePath)) {
      const raw = await fsp.readFile(cachePath, 'utf-8');
      const items = JSON.parse(raw);
      const combined = [...placeholderNews, ...items];
      const bySlug = new Map();
      combined.forEach((it) => bySlug.set(it.slug, it));
      return Array.from(bySlug.values()).map((item) => ({ params: { slug: item.slug }, props: { article: item } }));
    }

    const items = await fetchFreedaNews({ onlyActive: true });
    const combined = [...placeholderNews, ...items];
    const bySlug = new Map();
    combined.forEach((it) => bySlug.set(it.slug, it));
    return Array.from(bySlug.values()).map((item) => ({ params: { slug: item.slug }, props: { article: item } }));
  } catch (err) {
    console.error('getStaticPaths: Failed to read cache or fetch live, returning placeholders only', err?.message || err);
    return placeholderNews.map((item) => ({ params: { slug: item.slug }, props: { article: item } }));
  }
}

// Falls die Seite während der Laufzeit ohne props gerendert wird,
// versuchen wir anhand des Slugs das passende Item zu laden.
const slug = Astro.params.slug;
import fs from 'fs';
import fsp from 'fs/promises';
import path from 'path';

let article = Astro.props?.article ?? null;

if (!article) {
  const cachePath = path.resolve(process.cwd(), 'content/freeda-news.json');
  try {
    if (!shouldForceLive && fs.existsSync(cachePath)) {
      const raw = await fsp.readFile(cachePath, 'utf-8');
      const items = JSON.parse(raw);
      article = items.find((i) => i.slug === slug) || null;
    } else {
      const items = await fetchFreedaNews({ onlyActive: true });
      article = items.find((i) => i.slug === slug) || null;
    }
  } catch (err) {
    console.error('Article fetch fallback failed', err?.message || err);
    article = null;
  }
}

---

{article ? (
  <BaseLayout title={article.name} description={article.textShort}>
    <Header slot="header" />

    <PageHero
      title={article.name}
      subtitle={new Date(article.created).toLocaleDateString('de-DE')}
      backgroundImage={article.media?.url || '/images/sample/golf-tournament.jpg'}
    />

    <main class="container mx-auto px-4 py-12 max-w-3xl">
      <ArticleContent article={article} />
    </main>

    <Footer slot="footer" />
  </BaseLayout>
) : (
  <BaseLayout title="Artikel nicht gefunden">
    <Header slot="header" />
    <main class="container mx-auto px-4 py-24 text-center">
      <h1 class="text-3xl font-serif mb-4">Artikel nicht gefunden</h1>
      <p class="text-gray-600 mb-6">Der von Ihnen aufgerufene Artikel wurde nicht gefunden oder ist nicht (mehr) verfügbar.</p>
      <a href="/news" class="inline-block bg-emerald-700 text-white px-6 py-3 rounded">Zurück zur Übersicht</a>
    </main>
    <Footer slot="footer" />
  </BaseLayout>
)}
