---
interface SubNavigationItem {
  label: string;
  href: string;
}

interface Props {
  items: SubNavigationItem[];
  activeLabel?: string;
  parentTitle?: string;
}

const { items, activeLabel, parentTitle } = Astro.props;
---

<div class="bg-golf-gold shadow-md sticky top-[4.5rem] z-30 overflow-hidden">
  <!-- Background Parent Title for orientation -->
  {
    parentTitle && (
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-0">
        <span class="font-sans text-6xl md:text-8xl font-black uppercase tracking-[1em] text-white opacity-[0.08] whitespace-nowrap select-none">
          {parentTitle}
        </span>
      </div>
    )
  }

  <div
    class="container mx-auto px-4 overflow-x-auto scroller-hide relative z-10"
  >
    <ul
      class="flex items-center justify-center space-x-8 md:space-x-12 whitespace-nowrap min-w-max mx-auto"
    >
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              class={`text-sm font-bold uppercase tracking-widest transition-all duration-300 relative py-5 block
              ${
                activeLabel === item.label
                  ? "text-golf-green"
                  : "text-white hover:text-golf-green opacity-90 hover:opacity-100"
              }`}
            >
              {item.label}
              {activeLabel === item.label && (
                <span class="absolute bottom-0 left-0 w-full h-0.5 bg-golf-green" />
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
