---

---

<footer class="bg-golf-green text-white pt-20 pb-10">
  <div class="container mx-auto px-4 md:px-8">
    <!-- Top Footer Section -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16 border-b border-white/10 pb-12"
    >
      <!-- Brand -->
      <div class="space-y-6">
        <div class="flex items-center space-x-3">
          <div
            class="w-12 h-12 rounded-full flex items-center justify-center border-2 border-golf-gold-light text-golf-gold-light"
          >
            <span class="font-serif font-bold text-2xl">W</span>
          </div>
          <div>
            <span
              class="font-serif text-xl leading-none font-bold uppercase tracking-wider block"
              >Websweiler Hof</span
            >
            <span
              class="text-[10px] leading-none uppercase tracking-[0.2em] text-gray-400"
              >Golfclub Homburg</span
            >
          </div>
        </div>
        <p class="text-gray-400 text-sm leading-relaxed">
          Erholen, Golfspielen und Wohlfühlen am Websweiler Hof in Homburg.
        </p>
        <div class="flex space-x-4">
          <a
            href="#"
            aria-label="Facebook"
            class="w-12 h-12 rounded-full bg-white/5 flex items-center justify-center hover:bg-golf-gold transition-colors"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
              ></path></svg
            >
          </a>
          <a
            href="#"
            aria-label="Pinterest"
            class="w-12 h-12 rounded-full bg-white/5 flex items-center justify-center hover:bg-golf-gold transition-colors"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.174-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"
              ></path></svg
            >
          </a>
          <a
            href="#"
            aria-label="Twitter"
            class="w-12 h-12 rounded-full bg-white/5 flex items-center justify-center hover:bg-golf-gold transition-colors"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"
              ></path></svg
            >
          </a>
        </div>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-serif text-xl mb-6 text-golf-gold-light">Kontakt</h4>
        <ul class="space-y-4 text-gray-300">
          <li class="flex items-start">
            <svg
              class="w-5 h-5 text-golf-gold-light mr-3 mt-1 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span>Websweiler Hof<br />66424 Homburg/Saar<br />Deutschland</span>
          </li>
          <li class="flex items-center">
            <svg
              class="w-5 h-5 text-golf-gold-light mr-3 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            <span>06841 77 776-0</span>
          </li>
          <li class="flex items-center">
            <svg
              class="w-5 h-5 text-golf-gold-light mr-3 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <span>info@golfsaar.de</span>
          </li>
        </ul>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-serif text-xl mb-6 text-golf-gold-light">Links</h4>
        <ul class="space-y-1 text-gray-300">
          <li>
            <a
              href="#"
              class="py-1 inline-block hover:text-golf-gold transition-colors"
              >Startzeit buchen</a
            >
          </li>
          <li>
            <a
              href="/sport/turniere"
              class="py-1 inline-block hover:text-golf-gold transition-colors"
              >Turnierkalender</a
            >
          </li>
          <li>
            <a
              href="/mitgliedschaft"
              class="py-1 inline-block hover:text-golf-gold transition-colors"
              >Mitgliedschaft</a
            >
          </li>
          <li>
            <a
              href="/learning"
              class="py-1 inline-block hover:text-golf-gold transition-colors"
              >Golfschule</a
            >
          </li>
          <li>
            <a
              href="/gastronomie"
              class="py-1 inline-block hover:text-golf-gold transition-colors"
              >Gastronomie</a
            >
          </li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div>
        <h4 class="font-serif text-xl mb-6 text-golf-gold-light">Newsletter</h4>
        <p class="text-gray-400 text-sm mb-4">
          Abonnieren Sie unseren Newsletter für alle Neuigkeiten.
        </p>
        <form class="flex flex-col space-y-2">
          <input
            type="email"
            placeholder="Ihre E-Mail Adresse"
            aria-label="E-Mail Adresse für Newsletter"
            class="px-4 py-3 bg-white/5 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-golf-gold transition-colors"
          />
          <button
            class="px-4 py-3 bg-golf-gold text-white font-bold uppercase tracking-wider hover:bg-yellow-700 transition-colors"
          >
            Anmelden
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom Footer -->
    <div
      class="flex flex-col md:flex-row justify-between items-center text-xs text-gray-500 uppercase tracking-wider"
    >
      <p>
        &copy; {new Date().getFullYear()} Golfclub Homburg/Saar Websweiler Hof e.V.
      </p>
      <div class="space-x-6 mt-4 md:mt-0">
        <a href="/impressum" class="hover:text-white transition-colors"
          >Impressum</a
        >
        <a href="/datenschutz" class="hover:text-white transition-colors"
          >Datenschutz</a
        >
      </div>
    </div>
  </div>
</footer>
