---
import { Image } from "astro:assets";
import { getAssetImport } from "../utils/image-utils.js";

interface Props {
  article: any;
}
const { article } = Astro.props as Props;

// Glob import for assets
const freedaImages = import.meta.glob("../assets/freedaimg_*", {
  eager: true,
});
const assetImg = getAssetImport(article.media?.url, freedaImages);
const fallbackImg =
  (article.media?.url?.startsWith("http")
    ? article.media.url
    : null) || "/images/sample/golf-tournament.jpg";
---

<article
  class="bg-white rounded-lg shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-1"
>
  <div class="relative overflow-hidden group">
    {
      assetImg ? (
        <Image
          src={assetImg}
          alt={article.media?.name || article.name}
          class="w-full h-56 object-cover transition-transform duration-700 group-hover:scale-110"
          width={600}
          height={400}
        />
      ) : (
        <img
          src={fallbackImg}
          alt={article.media?.name || article.name}
          class="w-full h-56 object-cover transition-transform duration-700 group-hover:scale-110"
          loading="lazy"
        />
      )
    }
    <div class="absolute top-4 left-4 z-10">
      <time
        class="bg-white/90 backdrop-blur-sm text-golf-green text-xs px-3 py-1.5 rounded-full font-bold shadow-sm uppercase tracking-wider"
      >
        {new Date(article.created).toLocaleDateString("de-DE")}
      </time>
    </div>
  </div>
  <div class="p-6">
    <h3 class="text-xl font-serif text-gray-900 mb-3">
      <a
        href={`/news/${article.slug}`}
        class="hover:text-emerald-700 transition-colors"
        >{article.name}</a
      >
    </h3>
    {
      article.textShort &&
      /<\/?[a-z][\s\S]*>/i.test(article.textShort) ? (
        <div
          class="text-gray-600 mb-4 leading-relaxed"
          set:html={article.textShort}
        />
      ) : (
        <p class="text-gray-600 mb-4 leading-relaxed">
          {article.textShort}
        </p>
      )
    }
    <a
      href={`/news/${article.slug}`}
      class="inline-flex items-center text-emerald-700 hover:text-emerald-900 font-medium transition-colors"
      >Mehr erfahren
      <svg
        class="w-4 h-4 ml-2"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7"></path>
      </svg>
    </a>
  </div>
</article>
