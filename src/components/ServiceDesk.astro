---
interface ServiceItem {
  icon: string;
  title: string;
  desc: string;
  link: string;
}

const services: ServiceItem[] = [
  {
    icon: "calendar",
    title: "Turnierkalender",
    desc: "Anstehende Events",
    link: "/sport/turniere",
  },
  {
    icon: "trophy",
    title: "Greenfee",
    desc: "Preise & Gäste",
    link: "/mitgliedschaft",
  },
  {
    icon: "users",
    title: "Golf ausprobieren",
    desc: "SCHNUPPERKURS",
    link: "https://angebote.mitfit.de/?uuid=3d90a36b-ccbe-43c2-84a0-bfa837f03120&s=1&src=website_homecontent&type=publiclink",
  },
  {
    icon: "flag",
    title: "Platzreifekurs",
    desc: "Für Einsteiger",
    link: "https://angebote.mitfit.de/?uuid=e8d7f8fd-4fa0-4f70-be32-576e62f650ee",
  },
  {
    icon: "map-pin",
    title: "Kontakt & Anfahrt",
    desc: "Besuchen Sie uns",
    link: "/kontakt",
  },
];

const iconPaths: Record<string, string> = {
  calendar:
    "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
  trophy:
    "M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z",
  users:
    "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z",
  flag: "M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9",
  "map-pin":
    "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z",
};
---

<div class="relative z-20 -mt-16 md:-mt-24 container mx-auto px-4 mb-20">
  <div class="bg-white shadow-2xl rounded-sm overflow-hidden">
    <div
      class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 divide-y md:divide-y-0 md:divide-x divide-gray-100"
    >
      {
        services.map((service) => (
          <a
            href={service.link}
            target={service.link.startsWith("http") ? "_blank" : undefined}
            rel={
              service.link.startsWith("http")
                ? "noopener noreferrer"
                : undefined
            }
            class="group flex flex-row md:flex-col items-center justify-start md:justify-center py-6 md:py-10 px-6 md:px-4 hover:bg-golf-green transition-all duration-300 cursor-pointer"
          >
            <div class="text-golf-green group-hover:text-golf-gold mr-6 md:mr-0 md:mb-4 transition-colors duration-300 flex-shrink-0">
              <svg
                class="w-8 h-8"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d={iconPaths[service.icon]}
                />
              </svg>
            </div>
            <div class="flex flex-col items-start md:items-center">
              <h3 class="font-serif text-lg font-bold text-gray-800 group-hover:text-white mb-0.5 md:mb-1 transition-colors duration-300">
                {service.title}
              </h3>
              <p class="text-sm text-gray-500 group-hover:text-gray-300 transition-colors duration-300 uppercase tracking-wide">
                {service.desc}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</div>
