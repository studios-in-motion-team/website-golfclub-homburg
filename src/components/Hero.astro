---
---
<section class="relative h-screen w-full flex items-center justify-center overflow-hidden">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/header02.webp"
      alt="Golfclub Homburg Websweiler Hof"
      class="w-full h-full object-cover"
    />
    <!-- Dark Green Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/40 to-black/80 mix-blend-multiply"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 max-w-4xl mx-auto mt-16">
    <h2 class="text-golf-gold text-sm md:text-base font-bold uppercase tracking-[0.3em] mb-4">
      Ihr Golfclub in Homburg
    </h2>
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-serif text-white font-medium mb-6 leading-tight drop-shadow-2xl">
      Erholen, Golfspielen <br />
      <span class="italic">und Wohlfühlen</span>
    </h1>
    <p class="text-white text-lg md:text-xl mb-10 max-w-2xl mx-auto font-medium leading-relaxed drop-shadow-lg">
      Ein Freizeiterlebnis der besonderen Art erwartet Sie am Websweiler Hof. Ihr neuer Lieblingsort.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <button class="px-8 py-4 bg-white text-golf-green font-bold uppercase tracking-widest hover:bg-gray-100 transition-colors shadow-lg">
        Startzeit buchen
      </button>
      <a href="/mitgliedschaft" class="px-8 py-4 border-2 border-white text-white font-bold uppercase tracking-widest hover:bg-white/10 transition-colors inline-flex items-center justify-center">
        Mitglied werden
      </a>
    </div>
  </div>
</section>
